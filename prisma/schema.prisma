generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum Category {
  PROGRAM
  AI_SERVICE
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  /// 결제창을 열었지만 제한 시간 안에 결제하지 않아 자동 만료된 주문
  EXPIRED
}

/// 회원가입 휴대폰 문자 인증 — phone은 숫자만(01012345678)
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id           String     @id @default(cuid())
  /// 로그인 아이디 — 영문 소문자 시작, 소문자·숫자·밑줄 4~20자
  username     String     @unique
  /// 휴대폰 번호 — 숫자만(01012345678), 문자 인증 완료된 번호
  phone        String     @unique
  /// 가입 시 필수 입력 (결제사 구매자 정보·영수증 발송). 이메일 도입 전 가입 회원은 null → 마이페이지에서 등록
  email        String?    @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  /// 회원별 월 결제 설정 (관리자 지정) — 일괄 청구서 생성 시 기본값
  monthlyAmount Int?
  monthlyTitle  String?
  /// 회원별 결제일 (매월 N일, 1~31). 해당 월에 그 날짜가 없으면 말일로 본다
  billingDay    Int?
  /// 연속 로그인 실패 횟수 (성공하면 0으로 초기화)
  failedLoginCount Int       @default(0)
  /// 로그인 잠금 해제 시각. 연속 실패가 한도를 넘으면 설정된다
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// 프로그램 JWT 무효화 버전 — 비밀번호 변경·정지·탈퇴 시 1 증가
  tokenVersion     Int       @default(0)
  /// 회원가입 시 이용약관·개인정보 수집 동의 시각 (도입 전 가입 회원은 null)
  termsAgreedAt    DateTime?
  privacyAgreedAt  DateTime?
  orders       Order[]
  invoices     Invoice[]
  sessions     UserSession[]
}

/// 웹 로그인 세션 — JWT에는 id만 담고, 매 요청마다 여기서 유효성(폐기·만료)을 확인한다
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  /// 관리자 2단계 인증(문자)을 거쳐 만든 세션인지
  mfa          Boolean   @default(false)
  /// 로그인 당시 비밀번호가 현재 정책에 미달했는지 (관리자는 변경 전까지 관리자 기능 차단)
  weakPassword Boolean   @default(false)
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// 관리자 로그인 문자 인증번호 (회원당 1건, 코드는 HMAC 해시로 저장)
model LoginOtp {
  userId    String   @id
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// 보안·개인정보 접속기록 — 로그인, 관리자 열람·변경, 결제 검증 이벤트. 앱에서는 추가만 하고 수정·삭제하지 않는다
model AuditLog {
  id            String   @id @default(cuid())
  /// 행위자 회원 (로그인 실패 등 비회원 이벤트는 null)
  actorId       String?
  actorUsername String?
  action        String
  targetType    String?
  targetId      String?
  /// 검색어·변경 내용 등 부가 정보 (비밀번호·인증번호는 절대 넣지 않는다)
  detail        Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// 결제 유형 — ONE_TIME: 1회 결제(영구 사용권 등) / MONTHLY: 월 단위 이용료(첫 달은 주문 결제, 이후 청구서)
enum BillingType {
  ONE_TIME
  MONTHLY
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  summary      String
  description  String
  /// ONE_TIME이면 총액, MONTHLY면 1개월 이용료
  price        Int
  category     Category
  billingType  BillingType @default(ONE_TIME)
  /// 월 결제 상품의 계약 기간 범위(개월). 둘 다 비면 기간 제한 없음
  minMonths    Int?
  maxMonths    Int?
  downloadFile String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  orders       Order[]
}

/// 월 청구서 — 관리자가 발행, 회원이 마이페이지에서 결제
model Invoice {
  id           String        @id @default(cuid())
  userId       String
  billingMonth String
  title        String
  amount       Int
  memo         String?
  status       InvoiceStatus @default(UNPAID)
  /// 결제 예정일 (회원 결제일 기준). 지나면 연체로 표시
  dueDate      DateTime?
  /// 청구서 안내 문자 마지막 발송 시각
  notifiedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  orders       Order[]

  @@unique([userId, billingMonth])
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// 도입 문의 — 홈 문의 섹션·/contact 폼으로 접수. 관리자 문의 관리에서 확인·처리
model Inquiry {
  id          String        @id @default(cuid())
  name        String
  /// 숫자만 (01012345678)
  phone       String
  email       String?
  company     String?
  /// 관심 상품 슬러그 (선택)
  productSlug String?
  message     String
  status      InquiryStatus @default(NEW)
  /// 관리자 처리 메모 (회원에게 보이지 않음)
  adminMemo   String?
  /// 로그인 상태로 남겼으면 회원 ID
  userId      String?
  ipMasked    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

/// 홈페이지 접속 기록 — 관리자 접속 통계용. 회원은 userId, 비회원은 쿠키 기반 visitorId로 구분
model PageView {
  id        String   @id @default(cuid())
  /// 조회한 경로 (쿼리 제외, 200자 제한)
  path      String
  /// 로그인 회원이면 회원 ID (탈퇴·삭제와 무관하게 참조 없이 보관)
  userId    String?
  /// 익명 방문자 쿠키 ID
  visitorId String
  /// 마스킹된 IP (예: 211.234.xx.xx)
  ipMasked  String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  productId  String?
  invoiceId  String?
  orderId    String      @unique
  amount     Int
  status     OrderStatus @default(PENDING)
  paymentKey String?
  method     String?
  failReason String?
  paidAt     DateTime?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  product    Product?    @relation(fields: [productId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([status, createdAt])
}
